<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Quick Add Expense Shortcut -->
    <shortcut
        android:shortcutId="add_expense"
        android:enabled="true"
        android:icon="@drawable/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_add_expense_short"
        android:shortcutLongLabel="@string/shortcut_add_expense_long"
        android:shortcutDisabledMessage="@string/shortcut_disabled_message">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.example.fuel_expense_tracker"
            android:targetClass="com.example.fuel_expense_tracker.MainActivity">
            <extra android:name="route" android:value="/add-expense" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

